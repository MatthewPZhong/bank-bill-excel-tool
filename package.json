{
  "name": "bank-bill-excel-tool",
  "version": "1.5.3",
  "description": "网银账单小助手",
  "main": "src/main.js",
  "author": "Pzhong",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon:sync": "node scripts/sync-app-icon.js",
    "dist:win": "electron-builder --win",
    "dist:win:setup": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "preview": "node scripts/render-preview.js",
    "preview:account": "node scripts/render-account-mapping-preview.js",
    "smoke": "node scripts/smoke-test.js",
    "test:v1.5.2": "node scripts/test-v1.5.2-backend.js",
    "test:v1.5.2:sm": "node scripts/test-v1.5.2-state-machine.js",
    "startup:measure": "node scripts/measure-startup.js"
  },
  "build": {
    "appId": "com.openai.bankbillexceltool",
    "productName": "网银账单小助手",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "assets/**/*",
      "COMMON枚举.xlsx",
      "index.html",
      "src/**/*",
      "scripts/**/*",
      "CHANGELOG.md",
      "README.md",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeaderIcon": "build/icon.ico",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "marked": "^18.0.0",
    "pdfjs-dist": "^5.5.207",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  }
}
