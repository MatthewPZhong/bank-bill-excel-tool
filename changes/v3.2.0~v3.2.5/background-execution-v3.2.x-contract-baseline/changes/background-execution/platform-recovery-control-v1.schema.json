    "PreparedIntentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "intentId",
        "actionKey",
        "operationKey",
        "taskRunId",
        "jobId",
        "coordinationKind",
        "conflictScopeKey",
        "inspectorKey",
        "evidenceVersion",
        "evidenceHash",
