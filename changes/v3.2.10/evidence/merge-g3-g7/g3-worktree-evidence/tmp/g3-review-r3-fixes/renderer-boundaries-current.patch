+  assert.equal(f.reconPanel.controls.reconIdFixStatusBox.textContent.includes('已导出'), recon, 'Recon 已导出反馈按 scope 保留/清除');
+}
+
+test('审查探针：Recon 一次导出后场景选择须恢复', async (t) => {
