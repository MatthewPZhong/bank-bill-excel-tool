+        const mptMultipleCount = Number(reasonCounts['duplicate-inbound-mpt-candidate-count-multiple'] || 0);
+        const mptReuseCount = Number(reasonCounts['duplicate-inbound-mpt-candidate-reused-across-groups'] || 0);
