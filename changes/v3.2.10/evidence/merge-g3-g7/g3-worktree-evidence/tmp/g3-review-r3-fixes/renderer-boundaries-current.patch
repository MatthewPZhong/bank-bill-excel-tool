+  } };
+  const factory = options => { const descriptor = dom.createDialog(); dialogs.push({ options, descriptor }); return descriptor; };
+  const ui = { modalHost: host, modalBridge: bridge, status(_element, text, tone) { feedback.push({ text, tone }); },
