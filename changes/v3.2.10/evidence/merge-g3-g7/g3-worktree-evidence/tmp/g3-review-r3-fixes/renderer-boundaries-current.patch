+    const controls=target==='bank'?f.bankPanel.controls:f.reconPanel.controls;
+    const prefix=target==='bank'?'bankStatement':'reconIdFix';
+    assert.match(controls[prefix+'StatusBox'].textContent,/恢复前传输读取失败/);
+    assert.equal(controls[prefix+'ExportBtn'].disabled,true);
+    api.sessionStatus=original;
+    const held=f.main.hold(target==='bank'?'bank-statement:session-status':'recon-id-fix:session-status');
