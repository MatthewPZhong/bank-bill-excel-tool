-    return mixRgb({ r: 255, g: 255, b: 255 }, baseColor, y / Math.max(middleY, 1));
-  }
-
-  return mixRgb(
-    baseColor,
-    { r: 0, g: 0, b: 0 },
-    (y - middleY) / Math.max(safeHeight - middleY, 1)
-  );
-}
