+const { ensureVccOpCalcTablesSupport } = require('../../../src/backend/database/migrations');
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+}
+
+async function harness(t) {
