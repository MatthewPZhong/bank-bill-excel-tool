+          if (parentName !== 'si' || depth !== siDepth + 1 || phoneticRunDepth >= 0) {
+            finish(invalidSharedStrings('的 rPh 必须是 si 的直接子元素'));
+            return;
+          }
+          phoneticRunDepth = depth;
+        } else if (insideSi && name === 'phoneticpr') {
