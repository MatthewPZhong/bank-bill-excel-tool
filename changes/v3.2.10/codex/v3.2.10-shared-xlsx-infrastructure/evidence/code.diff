+      let rootSeen = false;
+      let rootClosed = false;
+      let depth = 0;
+      let rootDepth = -1;
+      let insideSi = false;
+      let siDepth = -1;
+      let textDepth = -1;
+      let richRunDepth = -1;
+      let phoneticRunDepth = -1;
+      let stringMode = null;
+      let plainTextSeen = false;
+      let richRunTextSeen = false;
+      let currentValue = '';
+      let currentTextValue = '';
+      let settled = false;
