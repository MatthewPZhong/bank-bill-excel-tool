-function parseCellBody(body, type, sharedStrings) {
-  if (type === 'inlineStr') {
-    T_CONTENT_RE.lastIndex = 0;
-    const parts = [];
-    let tm;
-    while ((tm = T_CONTENT_RE.exec(body))) parts.push(tm[1]);
-    return xmlUnescape(parts.join(''));
