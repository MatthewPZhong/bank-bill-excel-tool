+              cause: error.message
+            }));
+            return;
+          }
+          currentTextValue = '';
+          textDepth = -1;
+        } else if (name === 'rph' && depth === phoneticRunDepth) {
+          phoneticRunDepth = -1;
+        } else if (name === 'r' && depth === richRunDepth) {
+          richRunDepth = -1;
