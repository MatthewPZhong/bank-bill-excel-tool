+          finish(invalidSharedStrings('根节点或字符串节点未完整闭合'));
+          return;
+        }
+        finish();
+      });
+      stream.on('data', () => {
+        if (!settled && cancelToken && cancelToken.cancelled) {
+          const error = new ToolboxXlsxFormatError(
+            `${sourceFile || '该文件'}：sharedStrings.xml 读取已取消`,
+            { sourceFile }
+          );
