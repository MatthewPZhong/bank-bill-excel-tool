+  }
+  if (cell.cellType === 'error') {
+    return Object.freeze({
+      value: { error: String(cell.decodedSemanticValue || cell.rawLexicalValue || '#VALUE!') },
+      numFmtOverride: null
+    });
+  }
+  return Object.freeze({
+    value: cell.decodedSemanticValue == null ? '' : String(cell.decodedSemanticValue),
+    numFmtOverride: null
