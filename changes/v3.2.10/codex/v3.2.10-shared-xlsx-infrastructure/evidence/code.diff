+    parser.write(xml).close();
+  } catch (error) {
+    if (error instanceof ToolboxXlsxFormatError) throw error;
+    throw new ToolboxXlsxFormatError(`workbook.xml.rels 不是完整有效的 XML：${error.message}`, {
+      cause: error.message
+    });
