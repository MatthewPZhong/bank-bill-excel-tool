+            finish(invalidSharedStrings('的 si 必须是 sst 的直接子元素且不可嵌套'));
+            return;
+          }
+          insideSi = true;
+          siDepth = depth;
+          textDepth = -1;
+          richRunDepth = -1;
+          phoneticRunDepth = -1;
+          stringMode = null;
+          plainTextSeen = false;
+          richRunTextSeen = false;
