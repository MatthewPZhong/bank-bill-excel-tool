+    value: Object.freeze({
+      lexical,
+      canonical,
+      negative,
+      coefficientDigits,
+      decimalPower,
+      scale,
+      significantDigits,
+      integerDigits: nonZeroInteger.length,
+      isZero: firstNonZero < 0
