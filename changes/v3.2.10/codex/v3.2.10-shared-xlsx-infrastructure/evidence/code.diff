+    }
+    if (!type || !target) {
+      throw new ToolboxXlsxFormatError(`workbook.xml.rels 的关系 ${id} 缺少有效 Type 或 Target`, {
+        relationshipId: String(id),
+        type,
+        target: attrs.target
+      });
+    }
