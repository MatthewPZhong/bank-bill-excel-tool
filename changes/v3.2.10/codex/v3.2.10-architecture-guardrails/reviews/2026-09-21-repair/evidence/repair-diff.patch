+'use strict';
+
+// 执行规则和历史防倒退必须使用相同的词法包含关系。
+function scopeContains(outer, inner) {
+  return outer.path === inner.path && (outer.functionPath === null || outer.functionPath === inner.functionPath ||
+    (inner.functionPath !== null && inner.functionPath.startsWith(`${outer.functionPath}.`)));
+}
+
+function valueCandidates(value, seen = new Set()) {
+  if (!value || seen.has(value)) return [];
+  const next = new Set([...seen, value]);
+  return [value, ...(value.alternatives || value.values || []).flatMap(item => valueCandidates(item, next))];
+}
+
+function factoryCalls(scan, factory) {
+  return scan.sites.filter(site => site.type === 'call' && valueCandidates(site.reference).some(value =>
+    (value.chain || []).at(-1) === factory.name || value.functionPath?.split('.').at(-1) === factory.name));
+}
+
+function factoryPresent(scan, factory) {
+  const analysis = scan.analyses.get(factory.path);
+  return Boolean(analysis && [...analysis.functionNodes.keys()].some(name => name.split('.').at(-1) === factory.name));
+}
+
+// 参数代表显式注入合同；工厂结果保留创建者来源，不能靠局部变量命名判断能力。
+function callableOrigins(value, seen = new Set()) {
+  if (!value || seen.has(value)) return { known: false, modules: [] };
+  const next = new Set([...seen, value]);
+  const choices = value.alternatives || value.values;
+  if (choices) {
+    const origins = choices.map(item => callableOrigins(item, next));
+    return { known: choices.length > 0 && origins.every(item => item.known), modules: origins.flatMap(item => item.modules) };
+  }
+  if (value.reason === 'member-base') return callableOrigins(value.object, next);
+  if (value.kind === 'call-result') return value.callee?.module ? { known: true, modules: [value.callee.module] } : { known: false, modules: [] };
+  if (value.module) return { known: true, modules: [value.module] };
+  return { known: Boolean(value.functionPath || value.bindingKind === 'parameter' ||
+    value.kind === 'literal' || value.kind === 'regexp'), modules: [] };
+}
+
+module.exports = { scopeContains, valueCandidates, factoryCalls, factoryPresent, callableOrigins };
