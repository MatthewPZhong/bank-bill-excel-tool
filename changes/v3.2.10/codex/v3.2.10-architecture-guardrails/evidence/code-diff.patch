+test('AC22：真实 CI 事件选基线后，CLI 同样要求精确 repair 并保留激活约束', t => {
+  const f = cliRepository(t);
+  f.commit('S1 active');
+  f.write('architecture/boundaries.json', JSON.stringify(f.config).replace(/}$/, ',}'));
+  const broken = f.commit('S2 仅末尾逗号损坏');
+  f.save();
