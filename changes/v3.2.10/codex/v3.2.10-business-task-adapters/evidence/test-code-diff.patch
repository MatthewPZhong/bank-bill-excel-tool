index 00000000..46259200
--- /dev/null
+++ b/tests/unit/main-process/prepared-resource-scope.test.js
@@ -0,0 +1,87 @@
+'use strict';
+
+// G2-T1：固定旧 wrapper 的错误合同，显式复现目标修复；不表示 scope 已实现。
+// G2-T2 建立中立 scope 后迁移这些行为断言，删除旧导出时不要保留生产 shim。
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const {
+  runWithPreparedResourceCleanup
+} = require('../../../src/main-process/position-reconciliation/interactive-task-preflight');
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+test('接管前异步失败会等待 abandon，成功清理后保留同一原错误', async () => {
+  const operationError = Object.assign(new Error('准入失败'), { code: 'ADMISSION_REJECTED' });
+  const cleanupEntered = deferred();
+  const releaseCleanup = deferred();
+  let attempts = 0;
+  let settled = false;
+  const operation = runWithPreparedResourceCleanup({
+    async onAbandon() {
+      attempts += 1;
+      cleanupEntered.resolve();
+      await releaseCleanup.promise;
+    }
+  }, async () => { throw operationError; });
+  const observed = operation.then(
+    () => { settled = true; },
+    (error) => { settled = true; return error; }
+  );
+  try {
+    await cleanupEntered.promise;
+    assert.equal(attempts, 1);
+    assert.equal(settled, false);
+  } finally {
+    releaseCleanup.resolve();
+  }
+  assert.equal(await observed, operationError);
+  assert.equal(attempts, 1);
+});
+
+test('已有 lifecycle finally 双异常继续以 cleanup error 为主，且不自动重试', async () => {
+  const operationError = new Error('beforeStart 失败');
+  const cleanupError = Object.assign(new Error('暂存清理失败'), { code: 'CLEANUP_FAILED' });
+  let attempts = 0;
+  const operation = runWithPreparedResourceCleanup({
+    async onAbandon() { attempts += 1; throw cleanupError; }
+  }, async () => { throw operationError; });
+  await assert.rejects(operation, (error) => error === cleanupError);
+  await assert.rejects(operation, (error) => error === cleanupError);
+  assert.equal(attempts, 1);
+});
+
+test('接管后业务失败不调用通用 abandon', async () => {
+  const operationError = new Error('业务失败，领域保留恢复证据');
+  let attempts = 0;
+  const operation = runWithPreparedResourceCleanup({
+    async onAbandon() { attempts += 1; }
+  }, async (markExecuteStarted) => {
+    markExecuteStarted();
+    throw operationError;
+  });
+  await assert.rejects(operation, (error) => error === operationError);
+  assert.equal(attempts, 0);
+});
+
+// 使用实际旧 wrapper 执行目标断言。TODO 失败是已知缺口，绝不计为修复通过。
+// G2_T1_REQUIRE_TARGET=1 将目标断言变为失败门禁，便于后续确认修复已生效。
+test('目标：同步 work 抛错也必须 abandon 一次', {
+  todo: process.env.G2_T1_REQUIRE_TARGET === '1' ? false : 'G2-T2 待实现：旧 Promise.resolve(run()) 漏收口'
+}, async () => {
+  const original = new Error('同步构建失败');
+  let attempts = 0;
+  let received;
+  try {
+    await runWithPreparedResourceCleanup({
+      async onAbandon() { attempts += 1; }
+    }, () => { throw original; });
+  } catch (error) {
+    received = error;
+  }
+  assert.equal(received, original);
+  assert.equal(attempts, 1);
+});
