+test('其他 publication-only 领域仍透传 prepared hook，不扩大公共 receipt 确认范围', async () => {
+  const afterTerminal = () => {};
+  const harness = createArchiveAwareOperationHarness({ channel: 'pending:error:export-report',
+    runLifecycle: async () => ({ status: 'busy' }) });
